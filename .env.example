# ============================================================
# LoreLich Vault — Root .env.example
# Copy to apps/web/.env.local for frontend
# See docs/environment.md for full reference
# ============================================================

# Chain
NEXT_PUBLIC_CHAIN_ID=16602
NEXT_PUBLIC_RPC_URL=https://evmrpc-testnet.0g.ai

# Deployed Contract Addresses (fill after deploy)
NEXT_PUBLIC_LORE_VAULT_ADDRESS=0x
NEXT_PUBLIC_SOULBOUND_ADDRESS=0x

# WalletConnect
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=af1b488aaa85ce8dd622e9e44f3225f0

# 0G Storage
NEXT_PUBLIC_0G_INDEXER_URL=https://indexer-storage-testnet-standard.0g.ai
NEXT_PUBLIC_0G_RPC=https://evmrpc-testnet.0g.ai

# AI — SERVER SIDE ONLY — never prefix with NEXT_PUBLIC_
ANTHROPIC_API_KEY=sk-ant-

# Encryption
# Generate: openssl rand -hex 32
ENCRYPTION_SALT=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Rate Limiting (optional)
RATE_LIMIT_RPM=10

# Monitoring (optional)
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
